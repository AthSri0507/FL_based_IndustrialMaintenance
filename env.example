# Example environment variables for the fedind project
# Copy values into a local `.env` file or export in your shell.

# Reproducibility
PYTHONHASHSEED=42

# Server (uvicorn / FastAPI)
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Experiment outputs
EXPERIMENT_OUTPUT_DIR=experiments/outputs

# Hardware / device selection (auto, cpu, cuda)
DEVICE=auto

# Logging
LOG_LEVEL=INFO

# Jupyter (optional)
JUPYTER_PORT=8888
